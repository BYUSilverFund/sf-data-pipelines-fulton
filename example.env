# ====================================================
# sf-data-pipelines-fulton - Environment Variables
# ====================================================
# Copy this file to `.env` on your Fulton login node.

# --- Project Paths ---
# Absolute path to the repository directory on the Fulton supercomputer (used by crontab.sh)
USERNAME=
# username will be dynamically inserted in the paths below
DATA_ROOT=/home/${USERNAME}/groups/grp_msci_barra/nobackup/archive
PROJECT_PATH=/home/${USERNAME}/projects/sf-data-pipelines-fulton

# Root directory path on Fulton where Barra dataset files/zips are stored
DATA_ROOT=/path/to/barra/data

# --- AWS S3 Credentials ---
# IAM credentials with write access to destination S3 buckets (barra-stock-history, barra-covariance-matrices, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RDS credentials
DB_ENDPOINT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=